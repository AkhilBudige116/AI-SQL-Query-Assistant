# Groq LLM Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# MySQL Database Configuration (Read-only execution user)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=sql_reader
MYSQL_PASSWORD=your_readonly_password
MYSQL_DATABASE=ai_sql_assistant

# MySQL Admin Configuration (Used only for create_tables.py and sample_data.py)
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=your_root_password
